NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WS_PATH=/ws

MAX_PLAYERS=12
SERVER_TICK_RATE=60
SNAPSHOT_RATE=20
MATCH_DURATION_SECONDS=600
SCORE_LIMIT=25
RECONNECT_GRACE_MS=15000

SERVER_NAME=Reactor Atrium FFA
SERVER_REGION=local
LOG_LEVEL=info

# Optional local HTTP/WS discovery helpers for Vite split-port development:
# VITE_GAME_SERVER_URL=ws://localhost:8080/ws
# VITE_GAME_SERVER_HTTP_URL=http://localhost:8080

# Optional static client directory (default: dist)
# CLIENT_DIST=dist

# Production examples (Railway):
# ALLOWED_ORIGINS=https://YOUR-SERVICE.up.railway.app
# PUBLIC_SERVER_URL=https://YOUR-SERVICE.up.railway.app
#
# Railway supplies PORT automatically.
# Do not manually set PORT for a normal Railway deployment.
# RAILWAY_PUBLIC_DOMAIN is also injected and used when PUBLIC_SERVER_URL is unset.
#
# Do not set DATABASE_URL, Redis, Supabase, or volume paths — this game is session-only.
