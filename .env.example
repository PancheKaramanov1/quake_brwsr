# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PUBLIC_SERVER_URL=http://localhost:8080
WS_PATH=/ws
MAX_PLAYERS=12
MATCH_DURATION_SECONDS=600
SCORE_LIMIT=25
SERVER_TICK_RATE=60
SNAPSHOT_RATE=20
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
RECONNECT_GRACE_MS=15000
HEARTBEAT_INTERVAL_MS=2000
CONNECTION_TIMEOUT_MS=10000
LOG_LEVEL=info
NODE_ENV=development
SERVER_NAME=Reactor Atrium FFA
SERVER_REGION=local
TRUST_PROXY=false

# Client (Vite) — copy relevant vars into .env for local Vite
VITE_GAME_SERVER_URL=ws://localhost:8080/ws
VITE_GAME_SERVER_HTTP_URL=http://localhost:8080
